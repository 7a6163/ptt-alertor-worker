{
  "name": "ptt-alertor-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create ptt-alertor",
    "db:migrate:local": "wrangler d1 migrations apply ptt-alertor --local",
    "db:migrate:remote": "wrangler d1 migrations apply ptt-alertor --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "oxlint": "^1.89.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.101.0"
  }
}
